# =============================================================================
#                          Environment Variables
# =============================================================================
# Copy this file to `.env` and fill in the values.
#
# IMPORTANT: Never commit `.env` files containing real secrets.
# =============================================================================

# --- Application ---
NODE_ENV=development
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Database (MariaDB) ---
DATABASE_URL=mysql://user:password@localhost:3306/tattamam
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=tattamam

# --- Authentication (NextAuth.js) ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-a-random-secret-here     # openssl rand -base64 32

# --- Interaction Security ---
LIKE_SALT=generate-a-random-salt-here              # Used for visitor fingerprint hashing

# --- Email (Nodemailer — verification & password reset) ---
CONFIRMATION_MAIL_USER=your-email@example.com
CONFIRMATION_MAIL_PASSWORD=your-app-password

# --- Google APIs (optional — used for analytics/indexing scripts) ---
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_PUBLIC_BASE_URL=
